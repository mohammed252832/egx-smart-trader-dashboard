# Frontend (Vercel): public publishable key only; RLS enforces private member access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Canonical HTTPS origin used in password recovery links; no path or trailing slash.
NEXT_PUBLIC_SITE_URL=https://egx-smart-trader-dashboard.vercel.app

# Engine (GitHub Actions only): secret key; never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Universe, liquidity and data-quality thresholds live in this file.
# EGX_UNIVERSE_CONFIG=
EGX_UNIVERSE_CONFIG=engine/config/universe.json

# Real sources enabled by default. Synthetic data is never used in production.
EGX_YAHOO_ENABLED=true
EGX_YAHOO_UNIVERSE_URL=https://ticker.egidegypt.com/api/Feed/GetAllMarketWatchNames
EGX_YAHOO_RANGE=2y
EGX_YAHOO_HOSTS=query1.finance.yahoo.com,query2.finance.yahoo.com

EGX_BORSA_ENABLED=true
EGX_BORSA_BASE_URL=https://demo.borsa.ashh.me
EGX_BORSA_API_KEY=

# Credential-free delayed quotes. TradingView is an unofficial public endpoint.
EGX_TRADINGVIEW_ENABLED=true
EGX_TRADINGVIEW_SCANNER_URL=https://scanner.tradingview.com/egypt/scan
EGX_TRADINGVIEW_DELAY_SECONDS=900
EGX_TRADINGVIEW_CHUNK_SIZE=100
EGX_YAHOO_QUOTE_ENABLED=true
EGX_YAHOO_QUOTE_DELAY_SECONDS=1
EGX_QUOTE_FORCE_REFRESH=false

# Optional official EGID delayed feed; takes priority when both credentials exist.
EGID_ENABLED=true
EGID_USERNAME=
EGID_PASSWORD=
EGID_BASE_URL=https://ticker.egidegypt.com
EGID_DELAY_SECONDS=900

# Licensed HTTP providers. Repeat a block for each prefix in EGX_PROVIDERS.
# URL templates support {symbol}, {days}, {start}, {end}, {api_key}.
# AUTH_HEADER can be a header name (x-oanor-key) or "Authorization: Bearer {token}".
# EXTRA_HEADERS format: "Header: value, Header2: value2" (e.g. RapidAPI host).
EGX_PROVIDERS=DATACEDAR,EGID,BORSA,EGX,OANOR,EGXNEWS

DATACEDAR_API_KEY=
DATACEDAR_UNIVERSE_URL=
DATACEDAR_HISTORY_URL=

EGID_API_KEY=
EGID_UNIVERSE_URL=
EGID_HISTORY_URL=
EGID_AUTH_HEADER=
EGID_EXTRA_HEADERS=

BORSA_API_KEY=
BORSA_UNIVERSE_URL=
BORSA_HISTORY_URL=

EGX_API_KEY=
EGX_UNIVERSE_URL=
EGX_HISTORY_URL=

OANOR_API_KEY=
OANOR_UNIVERSE_URL=
OANOR_HISTORY_URL=
OANOR_AUTH_HEADER=x-oanor-key

EGXNEWS_API_KEY=
EGXNEWS_UNIVERSE_URL=
EGXNEWS_HISTORY_URL=
EGXNEWS_AUTH_HEADER=
EGXNEWS_EXTRA_HEADERS=

# Signal, risk and scoring thresholds live in this file.
EGX_SIGNALS_CONFIG=engine/config/signals.json

# Engine tuning
EGX_HISTORY_DAYS=400
EGX_HORIZON_DAYS=3
EGX_TOP_N=10
EGX_MARKET_UNIVERSE_SIZE=250
EGX_REQUEST_TIMEOUT=20
EGX_MODEL_VERSION=xgboost-v1

# Optional local CSV source
EGX_UNIVERSE_CSV=
EGX_HISTORY_DIR=
