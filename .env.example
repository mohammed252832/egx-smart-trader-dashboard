# Project URL: Settings > General > Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New Supabase "Publishable key" (sb_publishable_...) OR legacy anon key (eyJ...)
# Safe for the browser because RLS is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Engine only (GitHub Actions): new "Secret key" (sb_secret_...) OR legacy service_role key (eyJ...)
# NEVER expose this one in Vercel or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Generic HTTP provider. Repeat the block with DATACEDAR_, EGID_, BORSA_, EGX_ prefixes.
# URL templates support {symbol}, {days}, {api_key}.
DATACEDAR_API_KEY=
DATACEDAR_UNIVERSE_URL=
DATACEDAR_HISTORY_URL=

EGID_API_KEY=
EGID_UNIVERSE_URL=
EGID_HISTORY_URL=

BORSA_API_KEY=
BORSA_UNIVERSE_URL=
BORSA_HISTORY_URL=

EGX_API_KEY=
EGX_UNIVERSE_URL=
EGX_HISTORY_URL=

# Engine tuning
EGX_PROVIDERS=DATACEDAR,EGID,BORSA,EGX
EGX_USE_SAMPLE=true
EGX_HISTORY_DAYS=400
EGX_HORIZON_DAYS=3
EGX_TOP_N=10
EGX_TARGET_PCT=2.0
EGX_STOP_ATR=1.4
EGX_TARGET_ATR=2.4
EGX_MAX_STOP_PCT=8.0
EGX_REQUEST_TIMEOUT=20
EGX_MODEL_VERSION=xgboost-v1

# Optional local CSV source
EGX_UNIVERSE_CSV=
EGX_HISTORY_DIR=
